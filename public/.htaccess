# ============================================================================
# .htaccess — kassa-cto.ru на Beget shared hosting
# ============================================================================
# Next.js static export: URL /foo → foo.html, /dir/bar → dir/bar.html
# ВАЖНО: директории /instructions/, /kalkulyatory/ и т.д. существуют как
# папки с файлами внутри, но URL /instructions должен отдать instructions.html

RewriteEngine On

# ─── Переносы страниц (301) ─────────────────────────────────────────────────
# /diagnostika → /markirovka/diagnostika
Redirect 301 /diagnostika /markirovka/diagnostika


# ─── API proxy — /api/* → api/index.php ─────────────────────────────────────
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# ─── Clean URLs → .html files ───────────────────────────────────────────────
# Порядок важен: проверяем .html ПЕРЕД тем как Apache подхватит директорию

# Если запрос — реальный ФАЙЛ (не директория!), не трогаем
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /foo → foo.html (корневые страницы: /instructions → instructions.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+?)/?$ /$1.html [L]

# /dir/bar → dir/bar.html (/kalkulyatory/markirovka → kalkulyatory/markirovka.html)
RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
RewriteRule ^([^/]+)/([^/]+?)/?$ /$1/$2.html [L]

# /dir/sub/bar → dir/sub/bar.html (3-й уровень, если понадобится)
RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3.html -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+?)/?$ /$1/$2/$3.html [L]

# ─── 301 редирект HTTP → HTTPS ──────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://kassa-cto.ru/$1 [R=301,L]

# ─── 301 редирект www → non-www ─────────────────────────────────────────────
# Включено: редирект с www на основной домен kassa-cto.ru (без www)
# Даже если www не привязан как отдельный сайт, этот редирект защитит от дублей
RewriteCond %{HTTP_HOST} ^www\.kassa-cto\.ru$ [NC]
RewriteRule ^(.*)$ https://kassa-cto.ru/$1 [R=301,L]

# ─── 301 редирект старого домена ─────────────────────────────────────────────
RewriteCond %{HTTP_HOST} tellurmarkirovka\.vercel\.app [NC]
RewriteRule ^(.*)$ https://kassa-cto.ru/$1 [R=301,L]

# ─── Security Headers ───────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-DNS-Prefetch-Control "on"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mc.yandex.ru https://www.googletagmanager.com https://cdn.jsdelivr.net; connect-src 'self' https://mc.yandex.ru https://www.googletagmanager.com; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; frame-src https://www.googletagmanager.com"
</IfModule>

# ─── Кеш статики ────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 4 hours"
</IfModule>

# ─── Gzip сжатие ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ─── Запрет доступа к служебным файлам ──────────────────────────────────────
<FilesMatch "^(config\.php|\.env|\.htaccess)$">
  Require all denied
</FilesMatch>

# ─── Запрет листинга директорий ─────────────────────────────────────────────
Options -Indexes

# ─── Кастомные страницы ошибок ──────────────────────────────────────────────
ErrorDocument 404 /404.html
